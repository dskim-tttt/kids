    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <application android:label="여행 속도계" android:theme="@style/AppTheme" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@drawable/ic_trip" android:supportsRtl="true">
